  "case_notation": [
    {
      "pattern": "(?<![A-Za-z0-9])(?:\\d+(?:\\.\\d+)?)\\s*(?:KVA|KVAR|KWH|KV|KW|KA|KHZ|MHZ|HZ)(?![A-Za-z0-9])",
      "fix": "按 SI 词头规范改写：kV / kW / kVA / kvar / kWh / kA / kHz / MHz / Hz（k 小写、Hz 的 z 小写）",
      "source": "SI Brochure 9th ed. (BIPM) Table 5/6"
    },
    {
      "pattern": "(?<![A-Za-z0-9\\-])(?:\\d+(?:\\.\\d+)?)\\s*MA(?![A-Za-z0-9])",
      "fix": "mA（毫安）；若上下文为分断能力，疑为 kA 误写，须核实",
      "source": "SI Brochure 9th ed. (BIPM) 词头大小写"
    },
    {
      "pattern": "(?<![A-Za-z0-9])Sb\\d+(?![A-Za-z0-9])",
      "fix": "SB（按钮代号字母须全大写，如 SB1）",
      "source": "内部口径（CHINT 电气制图代号约定）"
    },
    {
      "pattern": "(?<![A-Za-z])(?!cos[ \\t]*[φϕ])[Cc][Oo][Ss][ \\t]*[φϕΦ]",
      "fix": "cos φ（功率因数符号规范写法）",
      "source": "ISO 80000-2（功率因数符号）"
    },
    {
      "pattern": "(?<=\\d)\\s*一\\s*(?=\\d)",
      "fix": "数值范围改用「～」或「—」（误用汉字「一」作连接号）",
      "source": "GB/T 15835—2011 5.1.3"
    },
    {
      "pattern": "(?<![A-Za-z0-9])\\d+[kK]\\d+[bB](?![A-Za-z0-9])",
      "fix": "改用标准中文表述（如「3 常开 3 常闭」，避免拼音简写）",
      "source": "内部口径"
    },
    {
      "pattern": "部份",
      "fix": "部分（统一简体规范字形）",
      "source": "《通用规范汉字表》（部份 为异体写法）"
    },
    {
      "pattern": "订做",
      "fix": "定制 / 定做（建议统一为「定制」）",
      "source": "内部口径"
    },
    {
      "pattern": "(?<![\\d.\\-−–])(\\d+(?:\\.\\d+)?)[-−–](\\d+(?:\\.\\d+)?)\\s*(?:[kKmM]?[A-Za-z]{1,3}|℃|%|％)(?![A-Za-z0-9])",
      "fix": "数值范围连接号改用「～」或「—」（GB/T 15835—2011）",
      "source": "GB/T 15835—2011 5.1.3；GB/T 15834—2011 4.13.3"
    },
    {
      "pattern": "(?<![\\d.%％])(\\d+(?:\\.\\d+)?)\\s*[~～—至]\\s*(\\d+(?:\\.\\d+)?)\\s*[%％]",
      "fix": "百分数范围两端都应带 %（GB/T 15835—2011）",
      "source": "GB/T 15835—2011 5.1.3（例：15％～30％，不写为 15～30％）"
    }
  ],
